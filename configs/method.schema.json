{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmaddshbg-blip/healthcare-energy-resilience-prioritization/blob/main/configs/method.schema.json",
  "title": "Healthcare energy resilience method contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_specification",
    "universe",
    "criteria",
    "context_only_fields",
    "preference_profiles",
    "uncertainty_axes",
    "hpsa",
    "primary",
    "sensitivities",
    "configuration_counts",
    "selection",
    "status_rule"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "method_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_name",
        "sha256"
      ],
      "properties": {
        "document_name": {
          "const": "HEALTHCARE_ENERGY_RESILIENCE_METHOD_SPECIFICATION.md"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "reference_count",
        "eligible_count",
        "exact_fips_replacements",
        "out_of_scope_fips"
      ],
      "properties": {
        "unit": {
          "const": "county_or_county_equivalent"
        },
        "reference_count": {
          "type": "integer",
          "minimum": 1
        },
        "eligible_count": {
          "type": "integer",
          "minimum": 1
        },
        "exact_fips_replacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_fips",
              "current_fips",
              "reason"
            ],
            "properties": {
              "source_fips": {
                "$ref": "#/$defs/fips"
              },
              "current_fips": {
                "$ref": "#/$defs/fips"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "out_of_scope_fips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fips"
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "transformation",
          "direction",
          "minimum",
          "maximum"
        ],
        "properties": {
          "id": {
            "enum": [
              "C_COUNT",
              "C_RATE",
              "C_HAZARD",
              "C_HPSA"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "transformation": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "const": "HIGHER_IS_GREATER_PRIORITY"
          },
          "minimum": {
            "const": 0.0
          },
          "maximum": {
            "const": 1.0
          }
        }
      }
    },
    "context_only_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preference_profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "weights"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weights": {
            "$ref": "#/$defs/weights"
          }
        }
      }
    },
    "uncertainty_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mask_states",
        "rate_states"
      ],
      "properties": {
        "mask_states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "masked_dme_value"
            ],
            "properties": {
              "id": {
                "enum": [
                  "MASK_LOWER",
                  "MASK_UPPER"
                ]
              },
              "masked_dme_value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 11
              }
            }
          }
        },
        "rate_states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "small_denominator_normalized_value"
            ],
            "properties": {
              "id": {
                "enum": [
                  "RATE_LOWER",
                  "RATE_UPPER"
                ]
              },
              "small_denominator_normalized_value": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        }
      }
    },
    "hpsa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_designation_types",
        "primary_status_set",
        "sensitivity_status_set",
        "score_minimum",
        "score_maximum",
        "county_aggregation"
      ],
      "properties": {
        "eligible_designation_types": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_status_set": {
          "$ref": "#/$defs/status_set"
        },
        "sensitivity_status_set": {
          "$ref": "#/$defs/status_set"
        },
        "score_minimum": {
          "const": 0
        },
        "score_maximum": {
          "const": 25
        },
        "county_aggregation": {
          "const": "MAXIMUM_ELIGIBLE_SCORE"
        }
      }
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity",
        "medicare_threshold",
        "hazard_context",
        "hpsa_status_set",
        "expected_configuration_count"
      ],
      "properties": {
        "capacity": {
          "const": 25
        },
        "medicare_threshold": {
          "const": 1000
        },
        "hazard_context": {
          "const": "ALL_HAZARD"
        },
        "hpsa_status_set": {
          "const": "DESIGNATED"
        },
        "expected_configuration_count": {
          "const": 20
        }
      }
    },
    "sensitivities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacities",
        "medicare_thresholds",
        "hpsa_status_sets",
        "hazard_codes"
      ],
      "properties": {
        "capacities": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "medicare_thresholds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "hpsa_status_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hazard_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{4}$"
          }
        }
      }
    },
    "configuration_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "capacity",
        "medicare_threshold",
        "hpsa_status",
        "hazard_specific",
        "total"
      ],
      "properties": {
        "primary": {
          "type": "integer",
          "minimum": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        },
        "medicare_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "hpsa_status": {
          "type": "integer",
          "minimum": 1
        },
        "hazard_specific": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric_type",
        "tie_absolute_tolerance",
        "tie_relative_tolerance",
        "boundary_tie_rule",
        "identifier_tie_breaking",
        "display_decimal_places"
      ],
      "properties": {
        "numeric_type": {
          "const": "IEEE_754_FLOAT64"
        },
        "tie_absolute_tolerance": {
          "const": 1e-12
        },
        "tie_relative_tolerance": {
          "const": 1e-12
        },
        "boundary_tie_rule": {
          "const": "LEAVE_CROSSING_TIE_GROUP_UNSELECTED"
        },
        "identifier_tie_breaking": {
          "const": false
        },
        "display_decimal_places": {
          "const": 6
        }
      }
    },
    "status_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ADVANCE",
        "NOT_ADVANCED",
        "ABSTAIN",
        "OUT_OF_SCOPE"
      ],
      "properties": {
        "ADVANCE": {
          "const": "SELECTED_IN_ALL_20_PRIMARY_AND_NO_BOUNDARY_TIE"
        },
        "NOT_ADVANCED": {
          "const": "SELECTED_IN_ZERO_PRIMARY_AND_NO_BOUNDARY_TIE"
        },
        "ABSTAIN": {
          "const": "SELECTED_IN_1_TO_19_PRIMARY_OR_ANY_BOUNDARY_TIE"
        },
        "OUT_OF_SCOPE": {
          "const": "ACCEPTED_UNRESOLVED_GEOGRAPHY_ONLY"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fips": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "C_COUNT",
        "C_RATE",
        "C_HAZARD",
        "C_HPSA"
      ],
      "properties": {
        "C_COUNT": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "C_RATE": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "C_HAZARD": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "C_HPSA": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "status_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statuses"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
