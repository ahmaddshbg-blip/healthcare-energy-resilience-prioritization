{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmaddshbg-blip/healthcare-energy-resilience-prioritization/blob/main/configs/staging_checkpoint.schema.json",
  "title": "Healthcare energy resilience staging checkpoint manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "status",
    "source_snapshot_id",
    "source_contract_sha256",
    "source_table_contract_sha256",
    "staging_table_contract_sha256",
    "content_hash_algorithm",
    "schema_hash_algorithm",
    "artifact_hash_algorithm",
    "parquet_hash_portability",
    "table_count",
    "total_row_count",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "manifest_type": {
      "const": "SOURCE_PRESERVING_STAGING_CHECKPOINT"
    },
    "status": {
      "const": "VALID"
    },
    "source_snapshot_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_table_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "staging_table_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "content_hash_algorithm": {
      "const": "SHA256_CANONICAL_TYPED_ROWS_V1"
    },
    "schema_hash_algorithm": {
      "const": "SHA256_CANONICAL_LOGICAL_AND_PHYSICAL_SCHEMA_V1"
    },
    "artifact_hash_algorithm": {
      "const": "SHA256_FILE_BYTES"
    },
    "parquet_hash_portability": {
      "const": "LOCAL_BINARY_EXACT_NOT_CROSS_PLATFORM_GUARANTEED"
    },
    "table_count": {
      "type": "integer",
      "minimum": 1
    },
    "total_row_count": {
      "type": "integer",
      "minimum": 0
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "output_type",
        "null_allowed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "output_type": {
          "enum": [
            "STRING",
            "INTEGER",
            "NUMBER",
            "DATETIME"
          ]
        },
        "null_allowed": {
          "type": "boolean"
        }
      }
    },
    "physical_column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "duckdb_type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "duckdb_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staging_table_id",
        "source_table_id",
        "relative_path",
        "row_count",
        "column_count",
        "columns",
        "logical_schema_sha256",
        "physical_columns",
        "physical_schema_sha256",
        "schema_sha256",
        "canonical_content_sha256",
        "artifact_sha256",
        "artifact_bytes"
      ],
      "properties": {
        "staging_table_id": {
          "type": "string",
          "pattern": "^stg_[a-z0-9_]+$"
        },
        "source_table_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^tables/[a-z0-9_]+\\.parquet$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "column_count": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "logical_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "physical_columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/physical_column"
          }
        },
        "physical_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
