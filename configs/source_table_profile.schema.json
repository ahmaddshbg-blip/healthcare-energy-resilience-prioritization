{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ahmaddshbg-blip/healthcare-energy-resilience-prioritization/blob/main/configs/source_table_profile.schema.json",
  "title": "Healthcare energy resilience source-table structural profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_type",
    "status",
    "source_snapshot_id",
    "source_contract_sha256",
    "source_table_contract_sha256",
    "table_count",
    "tables"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_type": {
      "const": "SOURCE_TABLE_STRUCTURE"
    },
    "status": {
      "const": "VALID"
    },
    "source_snapshot_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_table_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "table_count": {
      "type": "integer",
      "minimum": 1
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table_profile"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "csv_dialect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delimiter",
        "quote_character",
        "line_ending"
      ],
      "properties": {
        "delimiter": {
          "const": ","
        },
        "quote_character": {
          "const": "\""
        },
        "line_ending": {
          "enum": [
            "LF",
            "CRLF"
          ]
        }
      }
    },
    "key_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "nonblank_rows",
        "distinct_count",
        "duplicate_rows_beyond_first"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonblank_rows": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_rows_beyond_first": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "table_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "filename",
        "container",
        "sheet_name",
        "encoding",
        "byte_order_mark",
        "csv_dialect",
        "header_row",
        "data_row_count",
        "header_cell_count",
        "named_column_count",
        "data_row_field_count",
        "unnamed_header_positions",
        "header_sha256",
        "required_column_types",
        "record_key_evidence",
        "exact_duplicate_rows_beyond_first"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "container": {
          "enum": [
            "CSV",
            "XLSX"
          ]
        },
        "sheet_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding": {
          "enum": [
            "UTF-8",
            "WINDOWS-1252",
            "NOT_APPLICABLE_BINARY"
          ]
        },
        "byte_order_mark": {
          "enum": [
            "ABSENT",
            "PRESENT",
            "NOT_APPLICABLE"
          ]
        },
        "csv_dialect": {
          "oneOf": [
            {
              "$ref": "#/$defs/csv_dialect"
            },
            {
              "type": "null"
            }
          ]
        },
        "header_row": {
          "type": "integer",
          "minimum": 1
        },
        "data_row_count": {
          "type": "integer",
          "minimum": 0
        },
        "header_cell_count": {
          "type": "integer",
          "minimum": 1
        },
        "named_column_count": {
          "type": "integer",
          "minimum": 1
        },
        "data_row_field_count": {
          "type": "integer",
          "minimum": 1
        },
        "unnamed_header_positions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "header_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "required_column_types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "STRING",
              "INTEGER",
              "NUMBER",
              "DATETIME"
            ]
          }
        },
        "record_key_evidence": {
          "$ref": "#/$defs/key_evidence"
        },
        "exact_duplicate_rows_beyond_first": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
